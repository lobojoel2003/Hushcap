{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window. Kept to the minimum the UI needs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-title",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-ask",
    "window-state:default"
  ]
}
